# Copy to .env and fill in locally. Never commit .env.
# Setup guide for every option: docs/AI_PROVIDERS.md
#
# Everything works with the default (none). An LLM only adds natural-language
# understanding and wording; all numbers come from the deterministic engines.

# none | gemini | groq | ollama | custom
LIFECFO_LLM_PROVIDER=none

# Model name exactly as the provider lists it. Required unless provider is none.
LIFECFO_LLM_MODEL=

# Free-tier keys. Fill in only the one for the provider you selected.
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional. Override the endpoint (for example a remote Ollama), or set it for
# "custom", which is the hook for any future OpenAI-compatible provider.
LIFECFO_LLM_BASE_URL=
LIFECFO_LLM_API_KEY=

# Seconds to wait for one model response.
LIFECFO_LLM_TIMEOUT=60

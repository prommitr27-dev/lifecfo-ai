# Copy to .env and fill in locally. Never commit .env.

# "mock"   deterministic rule-based agent, no model and no network (default).
# "local"  a free open-source model running on this machine through Ollama.
# "api"    any hosted OpenAI-compatible endpoint (optional, may cost money).
LIFECFO_AGENT_MODE=mock

# Used by "local" and "api". The default points at a local Ollama server.
LIFECFO_LLM_BASE_URL=http://localhost:11434/v1
LIFECFO_LLM_MODEL=

# Required only for "api". Leave empty for "mock" and "local".
LIFECFO_LLM_API_KEY=
